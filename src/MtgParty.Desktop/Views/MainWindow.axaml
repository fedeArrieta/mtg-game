<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:MtgParty.Desktop.ViewModels"
        xmlns:views="using:MtgParty.Desktop.Views"
        x:Class="MtgParty.Desktop.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="Mesa del Caos"
        Width="1280" Height="820" MinWidth="900" MinHeight="560"
        Background="{StaticResource TableBrush}">
  <DockPanel>
    <Border DockPanel.Dock="Top" Padding="20,12,20,0">
      <TextBlock Classes="h1" Text="Mesa del Caos" />
    </Border>
    <TabControl Margin="8,0,8,0" SelectedIndex="{Binding SelectedTab}">
      <TabItem Header="Puzzles">
        <views:PuzzleView DataContext="{Binding Puzzles}" />
      </TabItem>
      <TabItem Header="Editor de puzzles">
        <views:PuzzleEditorView DataContext="{Binding Editor}" />
      </TabItem>
      <TabItem Header="Party game">
        <views:PartyView DataContext="{Binding Party}" />
      </TabItem>
    </TabControl>
  </DockPanel>
</Window>
