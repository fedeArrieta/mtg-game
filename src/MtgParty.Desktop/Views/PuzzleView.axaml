<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MtgParty.Desktop.ViewModels"
             x:Class="MtgParty.Desktop.Views.PuzzleView"
             x:DataType="vm:PuzzleViewModel"
             Focusable="True">
  <UserControl.KeyBindings>
    <KeyBinding Gesture="Space" Command="{Binding PassCommand}" />
    <KeyBinding Gesture="Enter" Command="{Binding PassCommand}" />
    <KeyBinding Gesture="Escape" Command="{Binding CancelTargetCommand}" />
    <KeyBinding Gesture="Ctrl+Z" Command="{Binding UndoCommand}" />
  </UserControl.KeyBindings>
  <UserControl.Styles>
    <Style Selector="Button">
      <Setter Property="Focusable" Value="False" />
    </Style>
  </UserControl.Styles>

  <Grid ColumnDefinitions="Auto,*,270">
    <!-- Lista de puzzles -->
    <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,1,0" Padding="12" Width="210" IsVisible="{Binding IsLibrary}">
      <DockPanel>
        <StackPanel DockPanel.Dock="Top" Spacing="2" Margin="0,0,0,10">
          <TextBlock Classes="h2" Text="Puzzles" />
          <TextBlock Classes="muted" Text="{Binding Progress}" />
        </StackPanel>
        <Button DockPanel.Dock="Bottom" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                Margin="0,10,0,0" Content="Abrir puzzle…" Click="OnOpen" />
        <ListBox ItemsSource="{Binding Puzzles}" SelectedItem="{Binding Selected}" Background="Transparent">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="vm:PuzzleItemViewModel">
              <StackPanel Spacing="2">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <TextBlock Text="✓" Foreground="{StaticResource GoldBrush}" IsVisible="{Binding Solved}" FontWeight="Bold" />
                  <TextBlock Text="{Binding Title}" FontWeight="Bold" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <TextBlock Text="{Binding Stars}" Foreground="{StaticResource GoldBrush}" FontSize="12" />
                  <TextBlock Text="propio" Classes="muted" FontSize="12" IsVisible="{Binding IsCustom}" />
                </StackPanel>
              </StackPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </DockPanel>
    </Border>

    <!-- Tablero: rival arriba, vos abajo, tu mano al pie -->
    <ScrollViewer Grid.Column="1">
      <StackPanel Margin="12,8" Spacing="6">
        <StackPanel Spacing="2">
          <TextBlock Classes="h2" Text="{Binding Title}" />
          <TextBlock Classes="muted" Text="{Binding Description}" TextWrapping="Wrap" />
        </StackPanel>

        <!-- Rival -->
        <Border Classes="zone">
          <Grid ColumnDefinitions="110,*,Auto">
            <StackPanel Spacing="6" Margin="0,0,8,6">
              <TextBlock Text="Rival" FontWeight="Bold" FontSize="15" />
              <Button Classes="life" Classes.targetable="{Binding EnemyTargetable}" Command="{Binding TargetOpponentCommand}"
                      ToolTip.Tip="Vidas del rival. Cuando lanzás algo con objetivo, tocá acá para apuntarle.">
                <TextBlock><Run Text="♥ " Foreground="{StaticResource DangerBrush}" /><Run Text="{Binding OpponentLife}" FontSize="26" FontWeight="Black" /></TextBlock>
              </Button>
            </StackPanel>
            <ScrollViewer Grid.Column="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
              <ItemsControl Classes="row" ItemsSource="{Binding EnemyCreatures}" MinHeight="{Binding Ui.CardHeight}" />
            </ScrollViewer>
            <ScrollViewer Grid.Column="2" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" MaxWidth="300">
              <ItemsControl Classes="lands" ItemsSource="{Binding EnemyLands}" Height="{Binding Ui.CardHeight}" />
            </ScrollViewer>
          </Grid>
        </Border>

        <!-- Fases, indicación y mensajes -->
        <StackPanel Spacing="4" Margin="4,0">
          <ItemsControl ItemsSource="{Binding Phases}" ItemTemplate="{StaticResource PhaseChipTemplate}">
            <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
          </ItemsControl>
          <TextBlock Text="{Binding Prompt}" FontSize="15" TextWrapping="Wrap" Classes.won="{Binding IsWon}" />
          <TextBlock Text="{Binding Message}" TextWrapping="Wrap" IsVisible="{Binding Message, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                     Classes.error="{Binding MessageIsError}" Classes.muted="{Binding !MessageIsError}" />
        </StackPanel>

        <!-- Vos -->
        <Border Classes="zone">
          <Grid ColumnDefinitions="110,*,Auto">
            <StackPanel Spacing="6" Margin="0,0,8,6">
              <TextBlock Text="Vos" FontWeight="Bold" FontSize="15" />
              <Button Classes="life" Classes.targetable="{Binding YouTargetable}" Command="{Binding TargetYouCommand}"
                      ToolTip.Tip="Tus vidas. Cuando lanzás algo con objetivo, tocá acá para apuntarte.">
                <TextBlock><Run Text="♥ " Foreground="{StaticResource DangerBrush}" /><Run Text="{Binding YourLife}" FontSize="26" FontWeight="Black" /></TextBlock>
              </Button>
              <TextBlock Text="{Binding Mana}" Foreground="{StaticResource GoldBrush}" FontSize="12" TextWrapping="Wrap" />
            </StackPanel>
            <ScrollViewer Grid.Column="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
              <ItemsControl Classes="row" ItemsSource="{Binding YourCreatures}" MinHeight="{Binding Ui.CardHeight}" />
            </ScrollViewer>
            <ScrollViewer Grid.Column="2" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" MaxWidth="300"
                          ToolTip.Tip="Tus tierras: tocá una para girarla y agregar su maná.">
              <ItemsControl Classes="lands" ItemsSource="{Binding YourLands}" Height="{Binding Ui.CardHeight}" />
            </ScrollViewer>
          </Grid>
        </Border>

        <!-- Mano -->
        <Border Classes="zone" Background="Transparent">
          <Grid ColumnDefinitions="110,*">
            <StackPanel Spacing="4" Margin="0,0,8,6">
              <TextBlock Text="Tu mano" FontWeight="Bold" FontSize="15" />
              <TextBlock Text="{Binding YourInfo}" Classes="zone" TextWrapping="Wrap" />
            </StackPanel>
            <ScrollViewer Grid.Column="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
              <ItemsControl Classes="row" ItemsSource="{Binding Hand}" MinHeight="{Binding Ui.CardHeight}" />
            </ScrollViewer>
          </Grid>
        </Border>
      </StackPanel>
    </ScrollViewer>

    <!-- Controles, pila e historial -->
    <Border Grid.Column="2" BorderBrush="{StaticResource LineBrush}" BorderThickness="1,0,0,0" Padding="12">
      <DockPanel>
        <StackPanel DockPanel.Dock="Bottom" Spacing="4" Margin="0,8,0,0">
          <TextBlock Classes="zone" Text="Tamaño de las cartas" />
          <Slider Minimum="80" Maximum="220" Value="{Binding Ui.CardWidth}" />
          <CheckBox Content="Imágenes en español" IsChecked="{Binding Ui.SpanishImages}" Focusable="False"
                    ToolTip.Tip="Si no hay impresión en español, se usa la inglesa. Vale para las cartas que se carguen desde ahora." />
        </StackPanel>
        <StackPanel DockPanel.Dock="Top" Spacing="8">
          <Button Classes="primary" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Padding="10"
                  Command="{Binding PassCommand}">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="{Binding PassLabel}" />
              <Border Classes="kbd"><TextBlock Text="Espacio" FontSize="11" Foreground="#E8DFF2" FontWeight="Normal" /></Border>
            </StackPanel>
          </Button>
          <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Content="Cancelar objetivo (Esc)"
                  Command="{Binding CancelTargetCommand}" IsVisible="{Binding IsTargeting}" />
          <Grid ColumnDefinitions="*,6,*" RowDefinitions="Auto,6,Auto">
            <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Content="Deshacer" ToolTip.Tip="Ctrl+Z"
                    Command="{Binding UndoCommand}" IsEnabled="{Binding CanUndo}" />
            <Button Grid.Column="2" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Content="Reiniciar"
                    Command="{Binding RestartCommand}" />
            <Button Grid.Row="2" Grid.ColumnSpan="3" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Content="Pedir una pista"
                    Command="{Binding HintCommand}" IsVisible="{Binding IsLibrary}" />
          </Grid>
          <StackPanel IsVisible="{Binding HasStack}" Spacing="4">
            <TextBlock Classes="zone" Text="Pila (arriba se resuelve primero)" />
            <ItemsControl ItemsSource="{Binding Stack}" ItemTemplate="{StaticResource StackCard}" />
          </StackPanel>
        </StackPanel>
        <Expander Header="Historial" VerticalAlignment="Top" HorizontalAlignment="Stretch" Margin="0,8,0,0">
          <ScrollViewer MaxHeight="320">
            <ItemsControl ItemsSource="{Binding Log}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="x:String">
                  <TextBlock Text="{Binding}" TextWrapping="Wrap" FontSize="12" Classes="muted" Margin="0,0,0,4" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </Expander>
      </DockPanel>
    </Border>
  </Grid>
</UserControl>
