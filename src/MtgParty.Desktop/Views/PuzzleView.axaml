<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MtgParty.Desktop.ViewModels"
             x:Class="MtgParty.Desktop.Views.PuzzleView"
             x:DataType="vm:PuzzleViewModel">
  <UserControl.Resources>
    <DataTemplate x:Key="CardTemplate" x:DataType="vm:CardViewModel">
      <Button Command="{Binding ClickCommand}" Padding="0" Background="Transparent" BorderThickness="0" Margin="0,0,8,8">
        <Border Classes="playcard" Classes.selected="{Binding Selected}" Opacity="{Binding Opacity}" Width="150" MinHeight="96">
          <StackPanel Spacing="2">
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Text="{Binding Name}" FontWeight="Bold" TextWrapping="Wrap" />
              <TextBlock Grid.Column="1" Text="{Binding Cost}" FontSize="11" Margin="4,0,0,0" />
            </Grid>
            <TextBlock Text="{Binding Text}" FontSize="11" TextWrapping="Wrap" Opacity="0.85" />
            <Grid ColumnDefinitions="*,Auto" Margin="0,4,0,0">
              <TextBlock Text="{Binding State}" FontSize="11" FontStyle="Italic" />
              <TextBlock Grid.Column="1" Text="{Binding Stats}" FontWeight="Bold" FontSize="15" />
            </Grid>
          </StackPanel>
        </Border>
      </Button>
    </DataTemplate>
  </UserControl.Resources>

  <UserControl.Styles>
    <Style Selector="Border.playcard">
      <Setter Property="Background" Value="#EFE3C8" />
      <Setter Property="BorderBrush" Value="#BFAE8A" />
      <Setter Property="BorderThickness" Value="2" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="8" />
      <Setter Property="TextElement.Foreground" Value="#2B2131" />
    </Style>
    <Style Selector="Border.playcard.selected">
      <Setter Property="BorderBrush" Value="#D4A64A" />
      <Setter Property="BorderThickness" Value="4" />
    </Style>
    <Style Selector="TextBlock.zone">
      <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Margin" Value="0,6,0,4" />
    </Style>
    <Style Selector="ItemsControl.cards">
      <Setter Property="ItemTemplate" Value="{StaticResource CardTemplate}" />
      <Setter Property="ItemsPanel">
        <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
      </Setter>
    </Style>
  </UserControl.Styles>

  <Grid ColumnDefinitions="Auto,*,280">
    <!-- Lista de puzzles -->
    <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,1,0" Padding="12" Width="230" IsVisible="{Binding IsLibrary}">
      <DockPanel>
        <StackPanel DockPanel.Dock="Top" Spacing="2" Margin="0,0,0,10">
          <TextBlock Classes="h2" Text="Puzzles" />
          <TextBlock Classes="muted" Text="{Binding Progress}" />
        </StackPanel>
        <Button DockPanel.Dock="Bottom" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                Margin="0,10,0,0" Content="Abrir puzzle…" Click="OnOpen" />
        <ListBox ItemsSource="{Binding Puzzles}" SelectedItem="{Binding Selected}" Background="Transparent">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="vm:PuzzleItemViewModel">
              <StackPanel Spacing="2">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <TextBlock Text="✓" Foreground="{StaticResource GoldBrush}" IsVisible="{Binding Solved}" FontWeight="Bold" />
                  <TextBlock Text="{Binding Title}" FontWeight="Bold" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <TextBlock Text="{Binding Stars}" Foreground="{StaticResource GoldBrush}" FontSize="12" />
                  <TextBlock Text="propio" Classes="muted" FontSize="12" IsVisible="{Binding IsCustom}" />
                </StackPanel>
              </StackPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </DockPanel>
    </Border>

    <!-- Tablero -->
    <ScrollViewer Grid.Column="1">
      <StackPanel Margin="16,12" Spacing="4">
        <TextBlock Classes="h2" Text="{Binding Title}" />
        <TextBlock Classes="muted" Text="{Binding Description}" TextWrapping="Wrap" />

        <Border Classes="card" Margin="0,10,0,0">
          <StackPanel>
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Text="Rival" FontWeight="Bold" FontSize="16" VerticalAlignment="Center" />
              <Button Grid.Column="1" Command="{Binding TargetOpponentCommand}" IsEnabled="{Binding IsTargeting}"
                      ToolTip.Tip="Elegir al rival como objetivo">
                <TextBlock><Run Text="{Binding OpponentLife}" FontWeight="Bold" FontSize="18" /><Run Text=" vidas" /></TextBlock>
              </Button>
            </Grid>
            <TextBlock Classes="zone" Text="Criaturas del rival" />
            <ItemsControl Classes="cards" ItemsSource="{Binding OpponentCreatures}" />
          </StackPanel>
        </Border>

        <Border Padding="12,8" Margin="0,6">
          <StackPanel Spacing="4">
            <TextBlock>
              <Run Text="Paso: " Foreground="{StaticResource MutedBrush}" /><Run Text="{Binding StepText}" FontWeight="Bold" />
              <Run Text="  ·  " Foreground="{StaticResource MutedBrush}" /><Run Text="{Binding Mana}" />
            </TextBlock>
            <TextBlock Text="{Binding Prompt}" FontSize="15" TextWrapping="Wrap"
                       Classes.won="{Binding IsWon}" />
            <TextBlock Text="{Binding Message}" TextWrapping="Wrap" IsVisible="{Binding Message, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                       Classes.error="{Binding MessageIsError}" Classes.muted="{Binding !MessageIsError}" />
          </StackPanel>
        </Border>

        <Border Classes="card">
          <StackPanel>
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Text="Vos" FontWeight="Bold" FontSize="16" VerticalAlignment="Center" />
              <Button Grid.Column="1" Command="{Binding TargetYouCommand}" IsEnabled="{Binding IsTargeting}"
                      ToolTip.Tip="Elegirte como objetivo">
                <TextBlock><Run Text="{Binding YourLife}" FontWeight="Bold" FontSize="18" /><Run Text=" vidas" /></TextBlock>
              </Button>
            </Grid>
            <TextBlock Classes="zone" Text="Tus criaturas" />
            <ItemsControl Classes="cards" ItemsSource="{Binding YourCreatures}" />
            <TextBlock Classes="zone" Text="Tus tierras (tocá para girar)" />
            <ItemsControl Classes="cards" ItemsSource="{Binding YourLands}" />
            <TextBlock Classes="zone" Text="Tu mano" />
            <ItemsControl Classes="cards" ItemsSource="{Binding Hand}" />
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>

    <!-- Controles, pila y registro -->
    <Border Grid.Column="2" BorderBrush="{StaticResource LineBrush}" BorderThickness="1,0,0,0" Padding="12">
      <DockPanel>
        <StackPanel DockPanel.Dock="Top" Spacing="8">
          <Button Classes="primary" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Padding="10"
                  Content="{Binding PassLabel}" Command="{Binding PassCommand}" />
          <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Content="Cancelar objetivo"
                  Command="{Binding CancelTargetCommand}" IsVisible="{Binding IsTargeting}" />
          <Grid ColumnDefinitions="*,8,*,8,*">
            <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Content="Deshacer"
                    Command="{Binding UndoCommand}" IsEnabled="{Binding CanUndo}" />
            <Button Grid.Column="2" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Content="Reiniciar"
                    Command="{Binding RestartCommand}" />
            <Button Grid.Column="4" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Content="Pista"
                    Command="{Binding HintCommand}" IsEnabled="{Binding IsLibrary}" />
          </Grid>
          <TextBlock Classes="zone" Text="Pila (arriba se resuelve primero)" />
          <ItemsControl ItemsSource="{Binding Stack}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="x:String">
                <Border Classes="card" Padding="8,4" Margin="0,0,0,4"><TextBlock Text="{Binding}" TextWrapping="Wrap" /></Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <TextBlock Classes="zone" Text="Qué pasó" />
        </StackPanel>
        <ScrollViewer>
          <ItemsControl ItemsSource="{Binding Log}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="x:String">
                <TextBlock Text="{Binding}" TextWrapping="Wrap" FontSize="12" Classes="muted" Margin="0,0,0,4" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </DockPanel>
    </Border>
  </Grid>
</UserControl>
